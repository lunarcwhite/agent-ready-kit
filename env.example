# Environment — copy to `.env` and fill in. Never commit `.env`.
# (Named `env.example` because tooling blocks dot-prefixed env files;
#  serves as the `.env.example` equivalent required by TASK-001.)
# See README.md for local development instructions.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (wired in TASK-003; placeholder for now)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_ready_kit

# Managed authentication behind identity abstraction (wired in TASK-010)
# AUTH_PROVIDER=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# AI provider (wired in M4; stays server-side only, never NEXT_PUBLIC_)
# AI_PROVIDER=
# AI_API_KEY=
# AI_DEFAULT_MODEL=
